cff-version: 1.2.0
message: "Swappy: Anomalous Transport in U(1)-Symmetric Quantum Circuits"
title: "Swappy: Reproducible code and data for anomalous transport in U(1)-symmetric quantum circuits"
type: software
authors:
  - family-names: "Summer"
    given-names: "Alessandro"
    orcid: "https://orcid.org/0009-0009-0791-7632"
  - family-names: "Nico-Katz"
